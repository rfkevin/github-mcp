{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-mcp",
  "account_id": "8508df2ab3bc8d7e6e2d37fde83dcbb3",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "65bb801d428d4250a4c8327310e0d065"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://github-mcp.rfahedkevin.workers.dev",
    "ALLOWED_GITHUB_USER_IDS": "105856986",
    "GITHUB_APP_ID": "5122110",
    "GITHUB_INSTALLATION_ID": "166154980",
    "GITHUB_OAUTH_CLIENT_ID": "Iv23liaWMkDZAKSVWClX",
    "GITHUB_WRITES_ENABLED": "true",
	"GITHUB_AUTOMATION_ENABLED": "true"
  },
  "env": {
    "cc2-test": {
      "name": "github-mcp-cc2-test",
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "70a3e86be3b148bca405a4c17fd1b651"
        }
      ],
      "vars": {
        "PUBLIC_ORIGIN": "https://github-mcp-cc2-test.rfahedkevin.workers.dev",
        "ALLOWED_GITHUB_USER_IDS": "105856986",
        "GITHUB_APP_ID": "5122110",
        "GITHUB_INSTALLATION_ID": "166154980",
        "GITHUB_OAUTH_CLIENT_ID": "Iv23liaWMkDZAKSVWClX",
        "GITHUB_WRITES_ENABLED": "true",
        "GITHUB_AUTOMATION_ENABLED": "false"
      }
    },
    "cc3-test": {
      "name": "github-mcp-cc3-test",
      "triggers": { "crons": ["*/15 * * * *"] },
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "beacde27f03846ebad15861eebe50c36"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "d1_databases": [
        {
          "binding": "COLLAB_DB",
          "database_name": "github-mcp-cc3-test",
          "database_id": "c7c75111-a0bd-41a6-9924-5f0e6a75ffd7"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "AGENT_RUN", "class_name": "AgentRunObject" }
        ]
      },
      "migrations": [
        { "tag": "cc5-l7b-agent-run", "new_sqlite_classes": ["AgentRunObject"] }
      ],
      "vars": {
        "PUBLIC_ORIGIN": "https://github-mcp-cc3-test.rfahedkevin.workers.dev",
        "ALLOWED_GITHUB_USER_IDS": "105856986",
        "GITHUB_APP_ID": "5122110",
        "GITHUB_INSTALLATION_ID": "166154980",
        "GITHUB_OAUTH_CLIENT_ID": "Iv23liaWMkDZAKSVWClX",
        "GITHUB_WRITES_ENABLED": "true",
        "GITHUB_AUTOMATION_ENABLED": "false",
        "COLLAB_STORE_ENABLED": "true",
        "CONTROLLER_CRON_ENABLED": "true",
        "CONTROLLER_WEBHOOK_ENABLED": "true",
        "AGENT_RUNS_ENABLED": "true",
        "AGENT_RUN_PARTICIPANTS": "claude,grok,vibe,gemini",
        "AGENT_RUN_MODEL": "workers-ai:@cf/zai-org/glm-4.7-flash",
        "AGENT_RUN_FAMILY_CLAUDE": "anthropic",
        "AGENT_RUN_MODELS_CLAUDE": "anthropic:claude-opus-5-5,anthropic:claude-sonnet-5-5,anthropic:claude-haiku-5-5",
        "AGENT_RUN_FAMILY_GROK": "xai",
        "AGENT_RUN_MODELS_GROK": "xai:grok-4.7,xai:grok-4.20-0309-non-reasoning",
        "AGENT_RUN_FAMILY_VIBE": "zai",
        "AGENT_RUN_MODELS_VIBE": "zai:glm-5.3,workers-ai:@cf/zai-org/glm-4.7-flash",
        "AGENT_RUN_FAMILY_GPT6": "openai",
        "AGENT_RUN_MODELS_GPT6": "groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b",
        "AGENT_RUN_FAMILY_GEMINI": "google",
        "GEMINI_FREE_PROJECT_ATTESTED": "true",
        "AGENT_RUN_MODELS_GEMINI": "gemini:gemini-3.8-flash,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash-lite,workers-ai:@cf/google/gemma-4-26b-a4b-it",
        "SALON_ENABLED": "true",
        "PRODUCT_CREATE_ENABLED": "true",
        "OWNER_AUTH_MODE": "secret",
        "GITHUB_CHECKS_CONFIG": "[{\"repository\":\"rfkevin/github-mcp\",\"ref\":\"master\",\"controllerSha\":\"774a3117e5359ca9c164fcef59fa6d6dc8b0bde7\"}]"
      }
    }
  },
  "previews": {
    "kv_namespaces": [
      {
        "binding": "OAUTH_KV",
        "id": "993dee7f12634524baace15e107729b9"
      }
    ],
    "vars": {
      "PUBLIC_ORIGIN": "",
      "ALLOWED_GITHUB_USER_IDS": "",
      "GITHUB_APP_ID": "",
      "GITHUB_INSTALLATION_ID": "",
      "GITHUB_OAUTH_CLIENT_ID": "",
      "GITHUB_AUTOMATION_ENABLED": "false"
    }
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
