{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-mcp",
  "account_id": "8508df2ab3bc8d7e6e2d37fde83dcbb3",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "65bb801d428d4250a4c8327310e0d065"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://github-mcp.rfahedkevin.workers.dev",
    "ALLOWED_GITHUB_USER_IDS": "105856986",
    "GITHUB_APP_ID": "5122110",
    "GITHUB_INSTALLATION_ID": "166154980",
    "GITHUB_OAUTH_CLIENT_ID": "Iv23liaWMkDZAKSVWClX",
    "GITHUB_WRITES_ENABLED": "true",
	"GITHUB_AUTOMATION_ENABLED": "true"
  },
  "env": {
    "cc2-test": {
      "name": "github-mcp-cc2-test",
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "70a3e86be3b148bca405a4c17fd1b651"
        }
      ],
      "vars": {
        "PUBLIC_ORIGIN": "https://github-mcp-cc2-test.rfahedkevin.workers.dev",
        "ALLOWED_GITHUB_USER_IDS": "105856986",
        "GITHUB_APP_ID": "5122110",
        "GITHUB_INSTALLATION_ID": "166154980",
        "GITHUB_OAUTH_CLIENT_ID": "Iv23liaWMkDZAKSVWClX",
        "GITHUB_WRITES_ENABLED": "true",
        "GITHUB_AUTOMATION_ENABLED": "false"
      }
    },
    "cc3-test": {
      "name": "github-mcp-cc3-test",
      "triggers": { "crons": ["*/15 * * * *"] },
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "beacde27f03846ebad15861eebe50c36"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "d1_databases": [
        {
          "binding": "COLLAB_DB",
          "database_name": "github-mcp-cc3-test",
          "database_id": "c7c75111-a0bd-41a6-9924-5f0e6a75ffd7"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "AGENT_RUN", "class_name": "AgentRunObject" }
        ]
      },
      "migrations": [
        { "tag": "cc5-l7b-agent-run", "new_sqlite_classes": ["AgentRunObject"] }
      ],
      "vars": {
        "PUBLIC_ORIGIN": "https://github-mcp-cc3-test.rfahedkevin.workers.dev",
        "ALLOWED_GITHUB_USER_IDS": "105856986",
        "GITHUB_APP_ID": "5122110",
        "GITHUB_INSTALLATION_ID": "166154980",
        "GITHUB_OAUTH_CLIENT_ID": "Iv23liaWMkDZAKSVWClX",
        "GITHUB_WRITES_ENABLED": "true",
        "GITHUB_AUTOMATION_ENABLED": "false",
        "COLLAB_STORE_ENABLED": "true",
        "CONTROLLER_CRON_ENABLED": "true",
        "CONTROLLER_WEBHOOK_ENABLED": "true",
        "AGENT_RUNS_ENABLED": "true",
        "AGENT_RUN_PARTICIPANTS": "claude,grok,vibe,gpt6,gemini",
        "AGENT_RUN_MODEL": "workers-ai:@cf/zai-org/glm-4.7-flash",
        "AGENT_RUN_FAMILY_CLAUDE": "anthropic",
        "AGENT_RUN_MODELS_CLAUDE": "anthropic:claude-opus-5-5,anthropic:claude-sonnet-5-5,anthropic:claude-haiku-5-5",
        "AGENT_RUN_FAMILY_GROK": "xai",
        "AGENT_RUN_MODELS_GROK": "xai:grok-4.7,xai:grok-4.20-0309-non-reasoning",
        "AGENT_RUN_FAMILY_VIBE": "zai",
        "AGENT_RUN_MODELS_VIBE": "zai:glm-5.3,workers-ai:@cf/zai-org/glm-4.7-flash",
        "AGENT_RUN_FAMILY_GPT6": "openai",
        "AGENT_RUN_MODELS_GPT6": "groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b",
        "AGENT_RUN_FAMILY_GEMINI": "google",
        "GEMINI_FREE_PROJECT_ATTESTED": "true",
        "AGENT_RUN_MODELS_GEMINI": "gemini:gemini-3.8-flash,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash-lite,workers-ai:@cf/google/gemma-4-26b-a4b-it",
        "SALON_ENABLED": "true",
        "AGENT_RUN_REPOSITORY": "rfkevin/github-mcp",
        "AGENT_RUN_CONTEXT_COMPACTION": "true",
        "AGENT_RUN_PREPARATION": "true",
        "AGENT_RUN_CONTINUITY": "true",
        "AGENT_RUN_GITHUB_WRITES": "true",
        "AGENT_RUN_GITHUB_WRITERS": "gemini,vibe",
        "AGENT_RUN_GITHUB_TASKS": "[{\"cycle\":\"cc8-systeme-unique\",\"task\":\"S7-live-gemini\",\"participant\":\"gemini\",\"branch\":\"mcp/105856986/gemini-api-s7-live\",\"paths\":[\"test/collab-store/agentrun/s7-live-gemini.spec.ts\"]},{\"cycle\":\"cc8-systeme-unique\",\"task\":\"S7-live-vibe\",\"participant\":\"vibe\",\"branch\":\"mcp/105856986/vibe-api-s7-live\",\"paths\":[\"test/collab-store/agentrun/s7-live-vibe.spec.ts\"]},{\"cycle\":\"cc8-systeme-unique\",\"task\":\"S8c-cron-monitor\",\"participant\":\"gemini\",\"branch\":\"mcp/105856986/gemini-api-s8c-cron-monitor\",\"paths\":[\"src/index.ts\",\"src/collab-store/controller/scheduled.ts\",\"src/collab-store/controller/monitor/\",\"src/collab-store/agentrun/event-monitor.ts\",\"test/collab-store/controller/cc8-monitor/\",\"test/collab-store/agentrun/cc8-cron-monitor.spec.ts\",\"docs/collaboration/cc8/s8c-monitor.md\"],\"mission\":\"functional\",\"acceptance\":[\"Le cron */15 reste un moniteur et ne lance aucun run, retry ou appel de modèle.\",\"Les incidents D1 sont typés et dédoublonnés, avec HALT, CAS et droits respectés.\",\"Des tests déterministes prouvent absence d'exécution directe et limites de périmètre.\"]},{\"cycle\":\"cc8-systeme-unique\",\"task\":\"S7-compare-vibe-1\",\"participant\":\"vibe\",\"branch\":\"mcp/105856986/vibe-api-s7-compare-1\",\"paths\":[\"test/collab-store/agentrun/s7-compare-vibe-1.spec.ts\"],\"mission\":\"functional\",\"acceptance\":[\"Créer UN test Vitest fonctionnel qui importe planGuidedS7 depuis src/collab-store/agentrun/s7-guided.ts et couvre un comportement réel ; pas de expect(true) ou test tautologique.\",\"Avec un scope valide et corrections_remaining=0, planGuidedS7 doit retourner {kind:'stop',reason:'commit_budget_exhausted'} sans appeler un modèle.\",\"Avec un scope valide et corrections_remaining=3 et branch_head absent, planGuidedS7 doit émettre l'appel serveur github_create_branch ; ne pas employer de module npm non déclaré.\"]},{\"cycle\":\"cc8-systeme-unique\",\"task\":\"S7-compare-gemini-1\",\"participant\":\"gemini\",\"branch\":\"mcp/105856986/gemini-api-s7-compare-1\",\"paths\":[\"test/collab-store/agentrun/s7-compare-gemini-1.spec.ts\"],\"mission\":\"functional\",\"acceptance\":[\"Créer UN test Vitest fonctionnel qui importe planGuidedS7 depuis src/collab-store/agentrun/s7-guided.ts et couvre un comportement réel ; pas de expect(true) ou test tautologique.\",\"Avec un scope valide et corrections_remaining=0, planGuidedS7 doit retourner {kind:'stop',reason:'commit_budget_exhausted'} sans appeler un modèle.\",\"Avec un scope valide et corrections_remaining=3 et branch_head absent, planGuidedS7 doit émettre l'appel serveur github_create_branch ; ne pas employer de module npm non déclaré.\"]},{\"cycle\":\"cc8-systeme-unique\",\"task\":\"S7-consultant-e2e-gemini-1\",\"participant\":\"gemini\",\"branch\":\"mcp/105856986/gemini-api-s7-consultant-e2e-1\",\"paths\":[\"test/collab-store/agentrun/s7-consultant-e2e-gemini-1.spec.ts\"],\"mission\":\"functional\",\"acceptance\":[\"AVANT d'écrire, consulter store_context, store_delta, store_memory, store_continuity et le fichier source src/collab-store/agentrun/guided-preparation.ts au SHA base réel (un simple message ne compte pas comme preuve).\",\"Créer un test Vitest fonctionnel important preparationViolation depuis src/collab-store/agentrun/guided-preparation.ts ; vérifier qu'une sortie sans tool_calls retourne no_tool_call, qu'un appel github_commit_files n'est pas autorisé dans la phase prepare, et qu'un appel store_context offert est autorisé.\",\"Utiliser la signature réellement lue depuis le dépôt, ne pas inventer de type, importer describe/it/expect de vitest ; réussir la CI puis ouvrir une PR ; effectuer store_handover {done,todo,learned} via le moteur.\"]},{\"cycle\":\"cc8-systeme-unique\",\"task\":\"S7-consultant-e2e-vibe-1\",\"participant\":\"vibe\",\"branch\":\"mcp/105856986/vibe-api-s7-consultant-e2e-1\",\"paths\":[\"test/collab-store/agentrun/s7-consultant-e2e-vibe-1.spec.ts\"],\"mission\":\"functional\",\"acceptance\":[\"AVANT d'écrire, consulter store_context, store_delta, store_memory, store_continuity et le fichier source src/collab-store/agentrun/guided-preparation.ts au SHA base réel ; explorer les dossiers au besoin avec github_list_directory.\",\"Créer un test Vitest fonctionnel important handoverViolation depuis src/collab-store/agentrun/guided-preparation.ts ; vérifier le refus no_tool_call sans tool_calls, l'acceptation d'un unique store_handover et le refus d'appels d'outils non autorisés.\",\"Utiliser la signature réellement lue depuis le dépôt, ne pas inventer de type, importer describe/it/expect de vitest ; réussir la CI puis ouvrir une PR ; effectuer store_handover {done,todo,learned} via le moteur.\"]}]",
        "AGENT_RUN_CHECKS": "true",
        "AUTO_MERGE_INTEGRATION": "true",
        "AUTO_MERGE_REPOSITORY": "rfkevin/github-mcp",
        "AUTO_MERGE_BRANCH": "mcp/105856986/cc3-integration",
        "PRODUCT_CREATE_ENABLED": "true",
        "OWNER_AUTH_MODE": "secret",
        "GITHUB_CHECKS_CONFIG": "[{\"repository\":\"rfkevin/github-mcp\",\"ref\":\"master\",\"controllerSha\":\"4c0a45acd6bb514d4cf130722b3898053dbde8c2\"}]"
      }
    }
  },
  "previews": {
