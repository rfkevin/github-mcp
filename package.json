{
  "name": "github-mcp",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test:unit": "vitest run",
    "test:ci-scripts": "node --test scripts/ci/checks.test.mjs scripts/deploy/deploy.test.mjs scripts/automation/runner.test.mjs scripts/diagnostics/openai-mcp.test.mjs",
    "diagnose:openai": "node scripts/diagnostics/openai-mcp.mjs",
    "check:quick": "node scripts/ci/run-checks.mjs quick",
    "check:full": "node scripts/ci/run-checks.mjs full",
    "release:rehearse": "node scripts/deploy/rehearse.mjs",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^26.6.3",
    "typescript": "^5.5.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.143.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.24.0",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.29.1"
    }
  }
}
